datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTHENTICATION & ACCESS CONTROL
// ==========================================

enum UserRole {
  SUPER_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model User {
  id           BigInt    @id @default(autoincrement())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(150)
  role         UserRole  @default(EMPLOYEE)
  employeeId   BigInt?   @unique @map("employee_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(6)

  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]

  @@map("users")
}

// ==========================================
// 2. ORGANIZATION & DEPARTMENTS
// ==========================================

model Department {
  id          BigInt     @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  code        String     @unique @db.VarChar(30)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.DateTime(6)

  employees   Employee[]

  @@map("departments")
}

// ==========================================
// 3. SHIFT CONFIGURATIONS
// ==========================================

model ShiftConfiguration {
  id                    BigInt     @id @default(autoincrement())
  name                  String     @db.VarChar(100)
  code                  String     @unique @db.VarChar(50)
  isOvernight           Boolean    @default(false) @map("is_overnight")
  startTimeLocal        String     @map("shift_start_local") @db.VarChar(16) // e.g. "17:30:00" or "10:00:00"
  endTimeLocal          String     @map("shift_end_local") @db.VarChar(16)   // e.g. "02:30:00" or "19:00:00"
  timezone              String     @default("Asia/Kolkata") @db.VarChar(64)
  durationMinutes       Int        @default(540) @map("duration_minutes") // 9 hours
  graceLateMinutes      Int        @default(15) @map("grace_late_minutes")
  graceEarlyExitMinutes Int        @default(15) @map("grace_early_exit_minutes")
  overtimeMinMinutes    Int        @default(30) @map("overtime_min_minutes")
  isDefault             Boolean    @default(false) @map("is_default")
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.DateTime(6)

  employees             Employee[]
  sessions              AttendanceSession[]

  @@map("shift_configurations")
}

// ==========================================
// 4. EMPLOYEES & BIOMETRIC MAPPING
// ==========================================

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  TERMINATED
  RESIGNED
}

model Employee {
  id                 BigInt                @id @default(autoincrement())
  employeeCode       String                @unique @map("employee_code") @db.VarChar(50) // Internal HR Code
  name               String                @db.VarChar(150)
  email              String?               @unique @db.VarChar(191)
  phone              String?               @db.VarChar(30)
  departmentId       BigInt?               @map("department_id")
  designation        String?               @db.VarChar(100)
  biometricNumber    String                @unique @map("biometric_number") @db.VarChar(50) // DS-K1T343EFWX employeeNoString
  status             EmploymentStatus      @default(ACTIVE)
  shiftId            BigInt?               @map("shift_id")
  dateOfJoining      DateTime              @map("date_of_joining") @db.Date
  profileImage       String?               @map("profile_image") @db.VarChar(500)
  createdAt          DateTime              @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.DateTime(6)

  department         Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  shift              ShiftConfiguration?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  user               User?
  rawEvents          BiometricRawEvent[]
  attendanceSessions AttendanceSession[]
  attendanceIntervals AttendanceInterval[]
  deviceMappings     EmployeeDeviceMapping[]
  corrections        AttendanceCorrection[]

  @@index([biometricNumber])
  @@index([departmentId])
  @@index([shiftId])
  @@map("employees")
}

model EmployeeDeviceMapping {
  id               BigInt    @id @default(autoincrement())
  employeeId       BigInt    @map("employee_id")
  deviceId         BigInt    @map("device_id")
  deviceEmployeeNo String    @map("device_employee_no") @db.VarChar(50)
  enrollmentTypes  String    @default("face,fingerprint") @map("enrollment_types") @db.VarChar(100)
  isEnrolled       Boolean   @default(true) @map("is_enrolled")
  syncedAt         DateTime  @default(now()) @map("synced_at") @db.DateTime(6)

  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device           BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceEmployeeNo])
  @@map("employee_device_mappings")
}

// ==========================================
// 5. BIOMETRIC HARDWARE & CREDENTIALS
// ==========================================

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  ERROR
}

model BiometricDevice {
  id                   BigInt                  @id @default(autoincrement())
  name                 String                  @db.VarChar(100)
  model                String                  @default("DS-K1T343EFWX") @db.VarChar(100)
  ipAddress            String                  @map("ip_address") @db.VarChar(64)
  port                 Int                     @default(80)
  useHttps             Boolean                 @default(false) @map("use_https")
  timezone             String                  @default("Asia/Kolkata") @db.VarChar(64)
  syncIntervalSeconds  Int                     @default(10) @map("sync_interval_seconds")
  connectionMethod     String                  @default("ISAPI_STREAM") @map("connection_method") @db.VarChar(30)
  status               DeviceStatus            @default(OFFLINE)
  serialNumber         String?                 @unique @map("serial_number") @db.VarChar(100)
  firmwareVersion      String?                 @map("firmware_version") @db.VarChar(100)
  lastConnectedAt      DateTime?               @map("last_connected_at") @db.DateTime(6)
  lastSyncAt           DateTime?               @map("last_sync_at") @db.DateTime(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.DateTime(6)

  credentials          DeviceCredential?
  checkpoints          DeviceSyncCheckpoint[]
  healthLogs           DeviceHealthLog[]
  rawEvents            BiometricRawEvent[]
  mappings             EmployeeDeviceMapping[]

  @@map("biometric_devices")
}

model DeviceCredential {
  id                BigInt          @id @default(autoincrement())
  deviceId          BigInt          @unique @map("device_id")
  username          String          @db.VarChar(100)
  encryptedPassword String          @map("encrypted_password") @db.VarChar(255)
  authType          String          @default("DIGEST") @map("auth_type") @db.VarChar(30)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime(6)

  device            BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_credentials")
}

// ==========================================
// 6. RAW BIOMETRIC EVENTS (IMMUTABLE LOG)
// ==========================================

model BiometricRawEvent {
  id               BigInt           @id @default(autoincrement())
  deviceId         BigInt?          @map("device_id")
  serialNo         Int              @map("serial_no")
  eventTimeUtc     DateTime         @map("event_time_utc") @db.DateTime(6)
  eventTimeDevice  String           @map("event_time_device") @db.VarChar(40)
  employeeNoString String           @map("employee_no_string") @db.VarChar(50)
  employeeId       BigInt?          @map("employee_id")
  cardNo           String?          @map("card_no") @db.VarChar(50)
  verifyMode       String?          @map("verify_mode") @db.VarChar(30) // face, fingerprint, card
  majorCode        Int?             @map("major_code")
  minorCode        Int?             @map("minor_code")
  attendanceStatus String?          @map("attendance_status") @db.VarChar(30)
  rawPayload       Json?            @map("raw_payload")
  ingestionSource  String           @default("stream") @map("ingestion_source") @db.VarChar(20) // stream or poll
  isProcessed      Boolean          @default(false) @map("is_processed")
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(6)

  device           BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  employee         Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  startIntervals   AttendanceInterval[] @relation("IntervalStartEvent")
  endIntervals     AttendanceInterval[] @relation("IntervalEndEvent")

  @@unique([serialNo, eventTimeDevice, employeeNoString], name: "unique_device_event")
  @@index([employeeNoString, eventTimeUtc])
  @@index([eventTimeUtc])
  @@index([isProcessed])
  @@map("biometric_raw_events")
}

// ==========================================
// 7. ATTENDANCE SESSIONS, INTERVALS & MULTI-PUNCH TRACKING
// ==========================================

enum AttendanceStatus {
  NOT_CHECKED_IN
  WORKING
  ON_BREAK
  COMPLETED
  LATE
  EARLY_EXIT
  HALF_DAY
  ABSENT
  ON_LEAVE
  MISSING_OUT
  FLAGGED
}

enum SessionCompletionStatus {
  ACTIVE
  COMPLETED
  PENDING_CLOSURE
  AUTO_CLOSED
}

enum IntervalType {
  WORK
  BREAK
  UNKNOWN
}

model AttendanceSession {
  id                    BigInt                  @id @default(autoincrement())
  employeeId            BigInt                  @map("employee_id")
  shiftId               BigInt?                 @map("shift_id")
  businessDate          DateTime                @map("business_date") @db.Date // Anchor date for overnight shift
  firstInTime           DateTime?               @map("first_in_time") @db.DateTime(6)
  lastInTime            DateTime?               @map("last_in_time") @db.DateTime(6)
  lastOutTime           DateTime?               @map("last_out_time") @db.DateTime(6)
  currentIntervalStart  DateTime?               @map("current_interval_start") @db.DateTime(6)
  inCount               Int                     @default(0) @map("in_count")
  outCount              Int                     @default(0) @map("out_count")
  completedBreakCount   Int                     @default(0) @map("completed_break_count")
  totalWorkingSeconds   Int                     @default(0) @map("total_working_seconds")
  totalBreakSeconds     Int                     @default(0) @map("total_break_seconds")
  totalElapsedSeconds   Int                     @default(0) @map("total_elapsed_seconds")
  totalWorkMinutes      Int                     @default(0) @map("total_work_minutes")
  lateMinutes           Int                     @default(0) @map("late_minutes")
  earlyExitMinutes      Int                     @default(0) @map("early_exit_minutes")
  overtimeMinutes       Int                     @default(0) @map("overtime_minutes")
  status                AttendanceStatus        @default(NOT_CHECKED_IN)
  completionStatus      SessionCompletionStatus @default(ACTIVE) @map("completion_status")
  isInferred            Boolean                 @default(false) @map("is_inferred")
  isOvernight           Boolean                 @default(true) @map("is_overnight")
  isManualCorrection    Boolean                 @default(false) @map("is_manual_correction")
  notes                 String?                 @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.DateTime(6)

  employee              Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift                 ShiftConfiguration?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  intervals             AttendanceInterval[]
  corrections           AttendanceCorrection[]

  @@unique([employeeId, businessDate])
  @@index([businessDate, status])
  @@index([employeeId, businessDate])
  @@map("attendance_sessions")
}

model AttendanceInterval {
  id              BigInt            @id @default(autoincrement())
  sessionId       BigInt            @map("session_id")
  employeeId      BigInt            @map("employee_id")
  intervalType    IntervalType      @default(WORK) @map("interval_type")
  startTime       DateTime          @map("start_time") @db.DateTime(6)
  endTime         DateTime?         @map("end_time") @db.DateTime(6)
  durationSeconds Int               @default(0) @map("duration_seconds")
  startEventId    BigInt?           @map("start_event_id")
  endEventId      BigInt?           @map("end_event_id")
  status          String            @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(6)

  session         AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startEvent      BiometricRawEvent? @relation("IntervalStartEvent", fields: [startEventId], references: [id], onDelete: SetNull)
  endEvent        BiometricRawEvent? @relation("IntervalEndEvent", fields: [endEventId], references: [id], onDelete: SetNull)

  @@index([sessionId, startTime])
  @@index([employeeId, startTime])
  @@map("attendance_intervals")
}

// ==========================================
// 8. DAILY ATTENDANCE AGGREGATION & AUDIT
// ==========================================

model AttendanceDailySummary {
  id                BigInt   @id @default(autoincrement())
  businessDate      DateTime @unique @map("business_date") @db.Date
  totalEmployees    Int      @default(0) @map("total_employees")
  presentCount      Int      @default(0) @map("present_count")
  absentCount       Int      @default(0) @map("absent_count")
  lateCount         Int      @default(0) @map("late_count")
  earlyExitCount    Int      @default(0) @map("early_exit_count")
  missingPunchCount Int      @default(0) @map("missing_punch_count")
  onLeaveCount      Int      @default(0) @map("on_leave_count")
  calculatedAt      DateTime @default(now()) @map("calculated_at") @db.DateTime(6)

  @@map("attendance_daily_summaries")
}

model AttendanceCorrection {
  id             BigInt            @id @default(autoincrement())
  sessionId      BigInt            @map("session_id")
  employeeId     BigInt            @map("employee_id")
  businessDate   DateTime          @map("business_date") @db.Date
  previousInTime DateTime?         @map("previous_in_time") @db.DateTime(6)
  newInTime      DateTime?         @map("new_in_time") @db.DateTime(6)
  previousOutTime DateTime?        @map("previous_out_time") @db.DateTime(6)
  newOutTime     DateTime?         @map("new_out_time") @db.DateTime(6)
  reason         String            @db.Text
  requestedBy    BigInt            @map("requested_by")
  approvedBy     BigInt?           @map("approved_by")
  status         String            @default("APPROVED") @db.VarChar(30)
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(6)

  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, businessDate])
  @@map("attendance_corrections")
}

model DeviceSyncCheckpoint {
  id                 BigInt          @id @default(autoincrement())
  deviceId           BigInt          @map("device_id")
  lastSyncTime       String          @map("last_sync_time") @db.VarChar(50)
  lastSerialNo       Int             @default(0) @map("last_serial_no")
  totalRecordsSynced Int             @default(0) @map("total_records_synced")
  syncStatus         String          @default("SUCCESS") @map("sync_status") @db.VarChar(30)
  lastError          String?         @map("last_error") @db.Text
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.DateTime(6)

  device             BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId])
  @@map("device_sync_checkpoints")
}

model DeviceHealthLog {
  id             BigInt          @id @default(autoincrement())
  deviceId       BigInt          @map("device_id")
  status         DeviceStatus
  responseTimeMs Int?            @map("response_time_ms")
  errorMessage   String?         @map("error_message") @db.Text
  loggedAt       DateTime        @default(now()) @map("logged_at") @db.DateTime(6)

  device         BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, loggedAt])
  @@map("device_health_logs")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(60)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)

  user       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
