# Hikvision Biometric Terminal Configuration
HIKVISION_IP=192.168.1.64
HIKVISION_PORT=80
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=Admin12345
HIKVISION_USE_HTTPS=false

# Local Biometric Connector
NEXTJS_API_URL=http://localhost:3000/api/biometric/events
CONNECTOR_API_SECRET=biometric-secure-secret-token-2026
POLL_INTERVAL_SECONDS=10

# Database Configuration (MySQL 8)
# If using local or Docker MySQL:
DATABASE_URL="mysql://root:@localhost:3306/biometric_db"

# Shift & Timezone Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
SECONDARY_TIMEZONE="America/New_York"
